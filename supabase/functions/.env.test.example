# Test Environment Variables
# Copy this file to .env.test - the values below work as-is for local Supabase.
#
# To confirm them for your setup, run: npx supabase status

# Local Supabase API URL
SUPABASE_URL=http://127.0.0.1:54321

# Publishable key - shown as "Publishable" in `npx supabase status`
# (The variable name stays SUPABASE_ANON_KEY: it is what tests/_setup.ts reads.)
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Secret key - shown as "Secret" in `npx supabase status`
# Required for the admin operations the integration tests perform.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Note: these are the Supabase CLI's fixed local development keys, identical on
# every machine, so they are safe to commit.
# NEVER use them in production - they are publicly known test keys.
#
# Key format changed: the CLI now issues `sb_publishable_*` / `sb_secret_*` and
# `npx supabase status` no longer prints the old `anon key` / `service_role key`
# JWTs. Those legacy JWTs are still accepted by the local stack, so an existing
# .env.test does not need to be updated - but new ones should use the values
# above, since the grep commands this file used to suggest now return nothing.
