# Discord OAuth Configuration
# Create an application at https://discord.com/developers/applications
# Configure OAuth2 redirect URI: http://127.0.0.1:54321/auth/v1/callback (for local dev)
# Note: Use 127.0.0.1, not localhost
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Google OAuth Configuration
# Create credentials at https://console.cloud.google.com/apis/credentials
# Configure OAuth consent screen and add redirect URI: http://127.0.0.1:54321/auth/v1/callback (for local dev)
# Note: Use 127.0.0.1, not localhost
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
