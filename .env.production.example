# =============================================================================
# Fantasy Reel - Production Environment Variables
# =============================================================================
# Copy this file and fill in your production values.
# NEVER commit actual secrets to version control.
#
# Frontend variables (Vercel): Add these in Vercel Dashboard → Settings → Environment Variables
# Backend variables (Supabase): Add these via `npx supabase secrets set` or Dashboard
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND (Vercel) - Next.js Environment Variables
# -----------------------------------------------------------------------------
# These are set in Vercel Dashboard → Project Settings → Environment Variables

# Supabase Connection (PUBLIC - safe to expose in browser)
# Get from: Supabase Dashboard → Settings → API
# Current production project ref: hgsusrgryybxsdjzlydq
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key-from-dashboard>

# TMDb API Key (for server-side API routes)
# Get from: https://www.themoviedb.org/settings/api
# Use the "API Read Access Token" (JWT format, starts with "eyJ...")
TMDB_API_KEY=your-tmdb-api-read-access-token

# OMDb API Key (for server-side API routes)
# Get from: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your-omdb-api-key

# Cron Job Authentication
# Generate with: openssl rand -hex 32
# Must match the CRON_SECRET in Supabase Edge Functions
CRON_SECRET=<generate-with-openssl-rand-hex-32>

# -----------------------------------------------------------------------------
# BACKEND (Supabase Edge Functions) - Secrets
# -----------------------------------------------------------------------------
# These are set via: npx supabase secrets set KEY=value
# Or in: Supabase Dashboard → Project Settings → Edge Functions → Secrets
#
# Note: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by Supabase

# TMDb API Key (same as frontend, for Edge Functions)
# TMDB_API_KEY=your-tmdb-api-read-access-token

# OMDb API Key (same as frontend, for Edge Functions)
# OMDB_API_KEY=your-omdb-api-key

# Resend Email Service
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Fantasy Reel <noreply@yourdomain.com>

# Cron Job Authentication (same as frontend)
# CRON_SECRET=your-random-secret-for-cron-authentication

# -----------------------------------------------------------------------------
# SUPABASE AUTH CONFIGURATION
# -----------------------------------------------------------------------------
# These are configured in Supabase Dashboard → Authentication → URL Configuration

# Site URL (your production domain)
# SITE_URL=https://your-production-domain.com

# Redirect URLs (add all allowed redirect destinations)
# REDIRECT_URLS=https://your-production-domain.com/**

# -----------------------------------------------------------------------------
# DISCORD OAUTH (Supabase Dashboard → Authentication → Providers → Discord)
# -----------------------------------------------------------------------------
# Create app at: https://discord.com/developers/applications
# Add redirect URL: https://your-project-ref.supabase.co/auth/v1/callback

DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# -----------------------------------------------------------------------------
# DEPLOYMENT COMMANDS REFERENCE
# -----------------------------------------------------------------------------
#
# Link to Supabase project:
#   npx supabase link --project-ref your-project-ref
#
# Push database schema:
#   npx supabase db push
#
# Deploy Edge Functions:
#   npx supabase functions deploy
#
# Set secrets:
#   npx supabase secrets set TMDB_API_KEY=value
#   npx supabase secrets set OMDB_API_KEY=value
#   npx supabase secrets set RESEND_API_KEY=value
#   npx supabase secrets set RESEND_FROM_EMAIL="Fantasy Reel <noreply@domain.com>"
#   npx supabase secrets set CRON_SECRET=value
#
# List secrets:
#   npx supabase secrets list
#
# View function logs:
#   npx supabase functions logs function-name
#
# Deploy to Vercel:
#   vercel --prod
# -----------------------------------------------------------------------------
