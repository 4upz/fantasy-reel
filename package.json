{
  "name": "fantasy-reel",
  "version": "1.0.0",
  "private": true,
  "_comment_types": "Consumed only by design-sync: it points the type extractor at the design-system barrel so emitted component prop contracts are real. Inert for the app build and for npm (this root package is private and never published).",
  "types": ".design-sync/entry.tsx",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "brand:assets": "node docs/brand/source/build-assets.mjs",
    "dev": "npm run dev --workspace=apps/frontend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build": "npm run build --workspace=apps/frontend",
    "lint": "npm run lint --workspace=apps/frontend",
    "test": "npm run test --workspace=apps/frontend",
    "design:barrel": "node .design-sync/generate-barrel.mjs",
    "design:barrel:check": "node .design-sync/generate-barrel.mjs --check",
    "design:barrel:test": "node --test .design-sync/generate-barrel.test.mjs",
    "test:functions": "./scripts/check-supabase.sh && cd supabase/functions && deno task test",
    "test:functions:watch": "./scripts/check-supabase.sh && cd supabase/functions && deno task test:watch",
    "test:functions:external": "./scripts/check-supabase.sh && cd supabase/functions && deno task test:external",
    "test:load:trades": "./scripts/check-supabase.sh && deno run --allow-all scripts/test-concurrent-trades.ts",
    "test:e2e": "./scripts/run-e2e-tests.sh",
    "test:e2e:ui": "./scripts/run-e2e-tests.sh --ui",
    "test:e2e:headed": "./scripts/run-e2e-tests.sh --headed",
    "test:e2e:debug": "./scripts/run-e2e-tests.sh --debug",
    "test:bot": "npm run test --workspace=apps/discord-bot",
    "test:draft:state": "node --test scripts/tests/draft-state.test.cjs scripts/tests/release-dates.test.cjs scripts/tests/draft-requests.test.cjs"
  },
  "devDependencies": {
    "supabase": "^2.72.8",
    "typescript": "^5.0.0"
  },
  "description": "Fantasy league for movies - draft upcoming releases and score based on review data",
  "keywords": [
    "fantasy",
    "movies",
    "league",
    "draft"
  ],
  "author": "",
  "license": "ISC"
}
