{
  "projectId": "080ba501-b4a4-4a38-8830-c40adcbf5698",
  "shape": "package",
  "pkg": "fantasy-reel",
  "globalName": "FantasyReel",
  "entry": ".design-sync/entry.tsx",
  "tsconfig": ".design-sync/tsconfig.build.json",
  "buildCmd": "node .ds-sync/node_modules/@tailwindcss/cli/dist/index.mjs -i .design-sync/tailwind-entry.css -o .design-sync/.cache/styles.css",
  "cssEntry": ".design-sync/.cache/styles.css",
  "extraFonts": [".design-sync/fonts/brand-fonts.css"],
  "docsDir": ".design-sync/docs",
  "readmeHeader": ".design-sync/conventions.md",
  "guidelinesGlob": [],
  "overrides": {
    "MovieDetailModal": { "cardMode": "single", "primaryStory": "Loaded", "viewport": "1100x820" },
    "AcceptConfirmModal": { "cardMode": "single", "primaryStory": "Default" },
    "PlaceBidModal": { "cardMode": "single", "primaryStory": "CounterBidding" },
    "PlaceCounterpickBidModal": { "cardMode": "single", "primaryStory": "CounterTarget" },
    "ChangePasswordModal": { "cardMode": "single", "primaryStory": "Default" },
    "ConfirmDeleteModal": { "cardMode": "single", "primaryStory": "Default" },
    "ConfirmKickModal": { "cardMode": "single", "primaryStory": "Default" },
    "HeroSection": { "cardMode": "single", "primaryStory": "Default", "viewport": "1280x900" },
    "MovieShowcase": { "cardMode": "column" },
    "ScoringReveal": { "cardMode": "column" },
    "CTAFooter": { "cardMode": "column" },
    "DraftTicker": { "cardMode": "column" },
    "NavLogo": { "cardMode": "column" },
    "TeamHeader": { "cardMode": "column" },
    "MovieTimelineCard": { "cardMode": "column" }
  },
  "provider": { "component": "WishlistProvider" },
  "componentSrcMap": {
    "WishlistProvider": null,

    "Avatar": "apps/frontend/app/components/Avatar.tsx",
