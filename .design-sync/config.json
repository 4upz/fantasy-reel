    "ScoringReveal": "apps/frontend/app/components/landing/ScoringReveal.tsx",
    "DraftTicker": "apps/frontend/app/components/landing/DraftTicker.tsx",
    "CTAFooter": "apps/frontend/app/components/landing/CTAFooter.tsx",

