# Sentry (error tracking) - frontend
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>  # Public DSN; browser + build both read this. Leave unset to disable Sentry entirely (no-op).
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>              # Server/edge-only DSN override; falls back to NEXT_PUBLIC_SENTRY_DSN if unset.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1                               # Trace sample rate for the client SDK, 0-1. Leave unset to keep the default (0.1).
# SENTRY_TRACES_SAMPLE_RATE=0.1                                          # Trace sample rate for server/edge configs, 0-1. Falls back to NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE, then 0.1.
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1                     # Session Replay: fraction of all sessions recorded, 0-1. Leave unset to keep the default (0.1). Set to 1.0 while testing.
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0                    # Session Replay: fraction of errored sessions recorded, 0-1. Leave unset to keep the default (1.0).
