<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple (requirements L-01). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Push notifications (O-01). Xcode signs App Store and TestFlight
	     builds with "production" in place of this. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Lets draft turns, outbids and trades waiting on you break through a
	     Focus (the push sets interruption-level time-sensitive). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Universal Links: site links open the matching screen (DeepLink.parse),
	     and passwords saved for the site fill in sign-in. The website serves
	     /.well-known/apple-app-site-association from apps/frontend/utils/app-links.ts. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.fantasyreel.com</string>
		<string>applinks:fantasyreel.com</string>
		<string>webcredentials:www.fantasyreel.com</string>
	</array>
</dict>
</plist>
