// Shared by every build configuration. Debug.xcconfig and Release.xcconfig include
// this file, then Local.xcconfig (gitignored) so you can override anything below
// without touching tracked files. Start from Local.example.xcconfig.

// Bundle identifier. The final value (and the Apple Developer team) is an owner
// decision (requirements §11); change it here once it is chosen.
FR_BUNDLE_IDENTIFIER = com.fantasyreel.ios

// Custom URL scheme for sign-in callbacks (OAuth and email links come back to
// fantasyreel://auth/callback). Supabase must list that URL as an allowed redirect.
FR_URL_SCHEME = fantasyreel

// The public website. Shared links on these hosts open the matching app screen.
// xcconfig treats "//" as a comment, hence the "$()" in the middle of URLs.
FR_SITE_URL = https:/$()/fantasyreel.com

// Capabilities: Sign in with Apple. A free personal team can't sign this
// capability for a device; set `CODE_SIGN_ENTITLEMENTS =` in Local.xcconfig to
// build without it (the Apple button then fails with an error, nothing else).
CODE_SIGN_ENTITLEMENTS = Config/FantasyReel.entitlements
