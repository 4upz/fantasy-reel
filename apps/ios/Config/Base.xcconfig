// Shared by every build configuration. Debug.xcconfig and Release.xcconfig include
// this file, then Local.xcconfig (gitignored) so you can override anything below
// without touching tracked files. Start from Local.example.xcconfig.

// Bundle identifier. The final value (and the Apple Developer team) is an owner
// decision (requirements §11); change it here once it is chosen.
FR_BUNDLE_IDENTIFIER = com.fantasyreel.ios

// Custom URL scheme for sign-in callbacks (OAuth and email links come back to
// fantasyreel://auth/callback). Supabase must list that URL as an allowed redirect.
FR_URL_SCHEME = fantasyreel

// The public website. Links on it and its bare domain open the matching app
// screen (Universal Links: the associated domains in FantasyReel.entitlements
// and apps/frontend/utils/app-links.ts). www is the canonical host; the bare
// domain redirects to it, so links the app shares use www and open the app
// directly. xcconfig treats "//" as a comment, hence the "$()" in URLs.
FR_SITE_URL = https:/$()/www.fantasyreel.com

// Capabilities: Sign in with Apple, push, Associated Domains. A free personal
// team can't sign these for a device; set `CODE_SIGN_ENTITLEMENTS =` in Local.xcconfig to
// build without it (the Apple button then fails with an error, nothing else).
CODE_SIGN_ENTITLEMENTS = Config/FantasyReel.entitlements

// The public Discord application (client) ID used to build the bot's "Add to
// Discord" link in league settings and the bot guide (the web's
// NEXT_PUBLIC_DISCORD_CLIENT_ID).
// Empty hides the button, as on the web.
FR_DISCORD_CLIENT_ID =
