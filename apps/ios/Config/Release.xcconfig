#include "Base.xcconfig"

// Production values are public (the web app ships the same URL and anon key).
// The URL is the project's custom domain, never <ref>.supabase.co: iOS names
// this host in the "wants to use … to sign in" prompt for Google and Discord.
// The anon key is set per machine until the release environment is decided
// (requirements N-01, §11). Put it in Local.xcconfig; the app shows a
// configuration error screen if the placeholder is still here at launch.
SUPABASE_URL = https:/$()/api.fantasyreel.com
SUPABASE_ANON_KEY = REPLACE_WITH_PRODUCTION_ANON_KEY

// The public Turnstile site key (the web's NEXT_PUBLIC_TURNSTILE_SITE_KEY).
// Production Supabase rejects password sign-in, sign-up, reset and resend
// without a security-check token (requirements N-03).
TURNSTILE_SITE_KEY = REPLACE_WITH_TURNSTILE_SITE_KEY

#include? "Local.xcconfig"
